{
  "name": "dsh-web-access",
  "version": "0.1.0",
  "description": "Port of pi-web-access to DeepSeek Harness: Tavily/Perplexity search providers over ctx.web, GitHub/PDF/YouTube-aware fetch provider with Firecrawl fallback, source_check, get_search_content, and web_enable gating.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "BEHAVIOR.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "web-search",
    "pi-web-access"
  ],
  "author": "Xiangzhe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/dsh-web-access.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "turndown": "7.2.4",
    "unpdf": "1.6.2"
  }
}
